# Groq API Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=gemma2-9b-it

# Database Configuration (Environment-based)
# PostgreSQL example: postgresql+asyncpg://postgres:postgres@localhost:5432/aivoa_db
# SQLite fallback for local dev: sqlite+aiosqlite:///./aivoa.db
DATABASE_URL=sqlite+aiosqlite:///./aivoa.db

# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
